# VITE_AAD_CLIENT_ID/VITE_AAD_TENANT_ID must be the SAME AAD app registration's client ID / tenant ID
# as AZURE_AD_CLIENT_ID/AZURE_AD_TENANT_ID in backend/local.settings.json.example (and vice versa) —
# otherwise require_role's audience check will reject every real token from the dashboard.
VITE_AAD_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AAD_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_API_BASE_URL=http://localhost:7071/api
